  "instructions": [
    {
      "id": "f8099421-af33-499d-bc78-207d9dfd2cce",
      "url": null,
      "text": "Mäso dáme do 1 PL oleja, osolíme a posypeme korením. Dáme marinovať 15 minút.",
      "image_url": null,
      "sort_order": 0,
      "is_group_header": false
    },
    {
      "id": "70596678-e548-4bf6-9277-4b9a07ac0f38",
      "url": null,
      "text": "Prudko osmažíme 1,5 min z oboch strán na panvici a dáme na 10 minút dopiecť do rozpálenej rúry na 190 °C.",
      "image_url": null,
      "sort_order": 1,
      "is_group_header": false
    },
    {
      "id": "5d65f8f6-1854-43c1-b20b-3d91150bb2ea",
      "url": null,
      "text": "Do výpeku pridáme kečup, chilly, med a podlejeme vývarom. Redukujeme 2-3 min, aby sa chute spojili.",
      "image_url": null,
      "sort_order": 2,
      "is_group_header": false
    },
    {
      "id": "7dd44da6-aea5-49bc-96b1-ca6e39d144cc",
      "url": null,
      "text": "Premiešame, odstavíme z ohňa a pridáme nalámanú čokoládu.",
      "image_url": null,
      "sort_order": 3,
      "is_group_header": false
    },
    {
      "id": "2e865026-e3d9-44ac-85ea-48cebd8423d8",
      "url": null,
      "text": "Omáčka má byť tekutá, lesklá, nie hustá.",
      "image_url": null,
      "sort_order": 4,
      "is_group_header": false
    }

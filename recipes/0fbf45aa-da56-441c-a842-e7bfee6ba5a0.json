  "instructions": [
    {
      "id": "bf6e2502-e0f4-4db1-a44b-b3e259148bcc",
      "url": null,
      "text": "Kuracie prsia nakrájame na cca 2 cm prúžky. Dáme ich do hlbokej misky a nasypeme zložky marinády a zalejeme vodou až po vrchnú vrstvu. Zamiešame.",
      "image_url": null,
      "sort_order": 0,
      "is_group_header": false
    },
    {
      "id": "26254b67-71d7-42ea-a110-41232fc67974",
      "url": null,
      "text": "Dáme na 2 hodiny do chladničky.",
      "image_url": null,
      "sort_order": 1,
      "is_group_header": false
    },
    {
      "id": "e62ece4d-625a-4939-9c3b-297445494458",
      "url": null,
      "text": "Do hladkej múky zamiešame soľ, korenie, cesnak, vajíčko a zriedime vodou na konzistenciu cesta na palacinky. ",
      "image_url": null,
      "sort_order": 2,
      "is_group_header": false
    },
    {
      "id": "a5f4046b-92d3-4a61-a844-420ce43a9e8c",
      "url": null,
      "text": "V druhej miske zmiešame múku, soľ a papriku.",
      "image_url": null,
      "sort_order": 3,
      "is_group_header": false
    },
    {
      "id": "ba8a5baf-4fa3-4760-b21b-47fc9e0e9a0d",
      "url": null,
      "text": "Do hlbokej panvice alebo hrnca nalejeme olej (aj liter). Obalíme stripsy v zmesi I a zmesi II a vyprážame 4-5 min v rozpálenom oleji.",
      "image_url": null,
      "sort_order": 4,
      "is_group_header": false
    },
    {
      "id": "8912378d-f70e-4e27-b930-497c139ab513",
      "url": null,
      "text": "Pozrite si celý recept aj s postupom na videu: https://youtu.be/yKSYEg3QmQQ?si=2ftnvnr3HOrR4hLb",
      "image_url": null,
      "sort_order": 5,
      "is_group_header": false
    }
  ],
